# Generated by tools/fill_and_verify.py. Do not edit by hand.
# Stash override: adds the Sensitive / AI / Honor-of-Kings groups and rules on top of an airport's
# subscribed config. Subscription links are override arguments: entered in the Stash app and stored
# only on the device, never in this file.
name: '分流分组（Sensitive / AI / Honor-of-Kings）'
desc: |-
  在机场订阅配置之上加入三个手动选择的分组和对应规则，规则排在最前面。
  每个组先选机场，再到「组名-机场」里选节点。订阅链接只保存在本机。
arguments-version: 1
arguments:
  sinx_url:
    type: input
    title: 'SinX 订阅链接'
    description: '填该机场 Stash 或 Clash 格式的订阅链接。暂时没有时先填其他机场的链接，不要留空或乱填，否则这个机场的小组会变成直连。'
    required: true
    min-length: 8
    max-length: 4096
  g94_url:
    type: input
    title: 'G94cloud 订阅链接'
    description: '填该机场 Stash 或 Clash 格式的订阅链接。暂时没有时先填其他机场的链接，不要留空或乱填，否则这个机场的小组会变成直连。'
    required: true
    min-length: 8
    max-length: 4096

proxy-providers:
  'SinX':
    url: '${args.sinx_url}'
    interval: 86400
  'G94cloud':
    url: '${args.g94_url}'
    interval: 86400

proxy-groups:
  - name: 'Sensitive'
    type: select
    proxies:
      - 'Sensitive-SinX'
      - 'Sensitive-G94cloud'
  - name: 'AI'
    type: select
    proxies:
      - 'AI-SinX'
      - 'AI-G94cloud'
  - name: 'Honor-of-Kings'
    type: select
    proxies:
      - 'Honor-of-Kings-SinX'
      - 'Honor-of-Kings-G94cloud'
  - name: 'Sensitive-SinX'
    type: select
    use:
      - 'SinX'
    lazy: true
  - name: 'Sensitive-G94cloud'
    type: select
    use:
      - 'G94cloud'
    lazy: true
  - name: 'AI-SinX'
    type: select
    use:
      - 'SinX'
    lazy: true
  - name: 'AI-G94cloud'
    type: select
    use:
      - 'G94cloud'
    lazy: true
  - name: 'Honor-of-Kings-SinX'
    type: select
    use:
      - 'SinX'
    lazy: true
  - name: 'Honor-of-Kings-G94cloud'
    type: select
    use:
      - 'G94cloud'
    lazy: true

rule-providers:
  rs-Sensitive:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/bark-jie/youtube-reviewed/main/ruleset/clash/Sensitive.yaml
    interval: 86400
  rs-AI:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/bark-jie/youtube-reviewed/main/ruleset/clash/AI.yaml
    interval: 86400
  rs-HonorOfKings:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/bark-jie/youtube-reviewed/main/ruleset/clash/HonorOfKings.yaml
    interval: 86400

rules:
  - RULE-SET,rs-Sensitive,Sensitive
  - RULE-SET,rs-AI,AI
  - RULE-SET,rs-HonorOfKings,Honor-of-Kings
  - DOMAIN-WILDCARD,*.sgameglobal.com.acc.*,Honor-of-Kings
  - DOMAIN-WILDCARD,hok*.intlgame.com,Honor-of-Kings
  - DST-PORT,5010,Honor-of-Kings
